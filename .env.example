VAULT_ADDR=https://vault:8200
VAULT_CACERT=/etc/vault/certs/ca.pem
GF_SECURITY_ADMIN_USER=your_grafana_user
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=appdb
REDIS_PASSWORD=pass
BACKEND=http://backend:8000
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@transcendence.local
ADMIN_PASSWORD=a_strong_password
ADMIN_API_KEY=ADMIN_API_KEY_VALUE
# The values below work as-is for a local test. For real use, replace each one
# with a random value without spaces, e.g. the output of: openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_use_openssl_rand_hex_32
ELASTIC_PASSWORD=change_me_elastic_password
KIBANA_PASSWORD=change_me_kibana_password
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=change_me_kibana_encryption_key_min_32_chars